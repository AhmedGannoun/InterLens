{
  "name": "interlens-root",
  "private": true,
  "workspaces": [
    "packages/core",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && node extension/esbuild.js",
    "test": "npm run build --workspace=packages/core && node node_modules/jest/bin/jest.js --config=jest.config.js --forceExit",
    "clean": "rimraf packages/core/out extension/out"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.10"
  }
}
