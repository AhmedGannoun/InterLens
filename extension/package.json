{
  "name": "interlens",
  "displayName": "InterLens",
  "description": "Proactive semantic conflict detection for distributed development teams.",
  "version": "0.1.0",
  "publisher": "interlens",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "interlens.explain",
        "title": "InterLens: Explain"
      },
      {
        "command": "interlens.setApiKey",
        "title": "InterLens: Set API Key"
      },
      {
        "command": "interlens.clearApiKey",
        "title": "InterLens: Clear API Key"
      },
      {
        "command": "interlens.testConnection",
        "title": "InterLens: Test LLM Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "interlens",
          "title": "InterLens",
          "icon": "$(sync)"
        }
      ]
    },
    "views": {
      "interlens": [
        {
          "id": "interlens.teammates",
          "name": "Teammates"
        }
      ]
    },
    "configuration": {
      "title": "InterLens",
      "properties": {
        "interlens.llm.provider": {
          "type": "string",
          "enum": ["ibm-bob", "openai", "anthropic", "openai-compatible", "none"],
          "default": "ibm-bob",
          "description": "LLM provider used by InterLens: Explain."
        },
        "interlens.llm.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier. Leave empty to use the provider default."
        },
        "interlens.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for ibm-bob (required) or openai-compatible provider."
        },
        "interlens.llm.bobTeamId": {
          "type": "string",
          "default": "",
          "description": "IBM Bob team ID. Required only when using a General API key."
        },
        "interlens.llm.timeoutMs": {
          "type": "number",
          "default": 20000,
          "description": "LLM request timeout in milliseconds."
        },
        "interlens.sync.fetchIntervalSec": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often to poll the Git remote for teammate snapshots (seconds). Demo: set to 3."
        },
        "interlens.sync.snapshotDebounceMs": {
          "type": "number",
          "default": 5000,
          "description": "Debounce delay after a file save before pushing a new snapshot (ms)."
        },
        "interlens.user.displayName": {
          "type": "string",
          "default": "",
          "description": "Your display name shown to teammates. Falls back to git user.name."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "vscode:prepublish": "node esbuild.js"
  },
  "dependencies": {
    "@interlens/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.21.5"
  }
}
